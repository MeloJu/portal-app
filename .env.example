# Copie para .env (ignorado pelo git) e ajuste. Valores de desenvolvimento apenas.

# Postgres do docker-compose
POSTGRES_DB=lumi
POSTGRES_USER=lumi
POSTGRES_PASSWORD=lumi
POSTGRES_PORT=5432

# Backend (backend/src/main/resources/application.yml le estas variaveis)
DB_URL=jdbc:postgresql://localhost:5432/lumi
DB_USER=lumi
DB_PASSWORD=lumi

# Base publica dos links curtos: no dev o link curto abre a Travessia no Vite;
# em producao e o dominio publico
PUBLIC_BASE_URL=http://localhost:5173

# Chave de assinatura do JWT: minimo 256 bits. Gere a sua com:
#   openssl rand -base64 32
# A app falha ao iniciar se esta variavel faltar ou for curta.
JWT_SECRET=

# Pepper dos codigos de verificacao: minimo 256 bits. Gere o seu com:
#   openssl rand -base64 32
# A app falha ao iniciar se esta variavel faltar ou for curta.
APP_CODE_PEPPER=

MAIL_ENABLED=false
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Cookie de sessao so por HTTPS. Em producao fica true (o default).
# Postman e curl nao enviam cookie Secure por http, entao para testar a API local
# diretamente, ponha false aqui -- nunca em producao.
SESSION_COOKIE_SECURE=false

# Base GeoLite2-Country.mmdb da MaxMind (conta gratis), guardada fora do Git. Vazio = GeoIP
# desligado e as Viagens ficam sem pais. Passo a passo em backend/docs/GEOIP.md.
GEOIP_DB_PATH=

SMTP_STARTTLS=false
SMTP_AUTH=true
