PORT=3001
# Chave da API v3 do VirusTotal (nunca commitar o .env real)
VT_API_KEY=

# Serviço de bypass para links com anúncio (opcional), acessado pela API oficial com chave contratada.
# Com "{url}" no endereço faz GET trocando pelo link; sem, faz POST com {"url": "<link>"}.
# Sem isto, a tela mostra o quadro do bypass.city para o usuário resolver.
BYPASS_API_URL=
BYPASS_API_KEY=
# BYPASS_API_KEY_HEADER=x-api-key
# BYPASS_PROVIDER_NAME=bypass.city
# BYPASS_PROVIDER_SITE=https://bypass.city/

# Navegador headless para links com anúncio (opcional): abre a página e captura para onde ela leva sozinha.
# Não resolve captcha nem clica em anúncios; se houver captcha, a tela usa o quadro do bypass.city.
# Usa o Edge/Chrome instalado (playwright-core, sem download de navegador).
BROWSER_RESOLVER=
# BROWSER_CHANNEL=msedge
# BROWSER_EXECUTABLE_PATH=
# BROWSER_WAIT_MS=12000
